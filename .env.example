# Email Service Configuration
# Option 1: Resend (recommended for simplicity)
RESEND_API_KEY=re_xxxxxxxxxxxxx
CONTACT_EMAIL=info@zimax.net

# Option 2: Azure Communication Services
# AZURE_COMM_SERVICES_CONNECTION_STRING=endpoint=https://...
# AZURE_COMM_SERVICES_FROM_EMAIL=noreply@zimax.net

# Option 3: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@zimax.net

# Database (optional - for storing submissions)
# DATABASE_URL=postgresql://...
# Or for Azure Table Storage:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://zimax.net
